    "import os\n",
    "os.chdir(r\"C:\\Users\\Haris\\Desktop\\hs\\python\")\n",
    "print(os.getcwd())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "c4e1e450-ce41-486b-9b20-771cfcc701c3",
   "metadata": {},
   "outputs": [
    {
