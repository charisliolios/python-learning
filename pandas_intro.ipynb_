      "(323, 3)\n",
      "  Source  Year    Mean\n",
      "0   GCAG  1850 -0.4265\n",
      "1   GCAG  1851 -0.2635\n",
      "2   GCAG  1852 -0.2241\n",
      "3   GCAG  1853 -0.2623\n",
      "4   GCAG  1854 -0.2936\n",
      "5   GCAG  1855 -0.2914\n",
      "6   GCAG  1856 -0.3281\n",
      "7   GCAG  1857 -0.4659\n",
      "8   GCAG  1858 -0.3968\n",
      "9   GCAG  1859 -0.2920\n",
      "Source     object\n",
      "Year        int64\n",
      "Mean      float64\n",
      "dtype: object\n"
     ]
    }
   ],
   "source": [
    "import pandas as pd\n",
    "\n",
    "df = pd.read_csv(\"global_temp.csv\")\n",
    "\n",
    "print(df.shape)\n",
    "print(df.head(10))\n",
    "print(df.dtypes)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "e3e0c799-9028-4965-9edf-a8da728ee2f3",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Hottest year: 2024 | Anomaly: 1.1695\n",
      "Coldest year: 1904 | Anomaly: -0.5971\n",
      "Average anomaly: -0.0539\n",
      "Years above baseline: 59\n"
     ]
    }
   ],
   "source": [
    "gcag = df[df[\"Source\"] == \"GCAG\"]\n",
    "\n",
    "# Highest anomaly year\n",
    "max_row = gcag.loc[gcag[\"Mean\"].idxmax()]\n",
    "print(\"Hottest year:\", int(max_row[\"Year\"]), \"| Anomaly:\", max_row[\"Mean\"])\n",
    "\n",
    "# Lowest anomaly year\n",
    "min_row = gcag.loc[gcag[\"Mean\"].idxmin()]\n",
    "print(\"Coldest year:\", int(min_row[\"Year\"]), \"| Anomaly:\", min_row[\"Mean\"])\n",
    "\n",
    "# Average\n",
    "print(\"Average anomaly:\", round(gcag[\"Mean\"].mean(), 4))\n",
    "\n",
    "# Years with positive anomaly\n",
    "positive = gcag[gcag[\"Mean\"] > 0]\n",
    "print(\"Years above baseline:\", len(positive))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "f77c2951-9ebd-4751-aded-1ba57880131a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "gcag = df[df[\"Source\"] == \"GCAG\"]\n",
    "\n",
    "colors = [\"red\" if x > 0 else \"blue\" for x in gcag[\"Mean\"]]\n",
    "\n",
    "plt.figure(figsize=(14, 5))\n",
    "plt.bar(gcag[\"Year\"], gcag[\"Mean\"], color=colors)\n",
    "plt.axhline(0, color=\"black\", linewidth=0.8)\n",
    "plt.title(\"Global Temperature Anomaly 1850-2026 (GCAG)\")\n",
    "plt.xlabel(\"Year\")\n",
    "plt.ylabel(\"Temperature Anomaly (°C)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
